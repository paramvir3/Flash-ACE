# Scaling benchmark. Same physics as in.bench, with the system size set by
# -var rx/-var ry (replication factors) and capacities matched per size.
units           metal
atom_style      atomic
newton          on
boundary        p p p

read_data       ../test_lammps_cspbi3_mpi/data.NVT
replicate       ${rx} ${ry} 1

mass            1 132.905
mass            2 204.199
mass            3 126.900

if "${style} == aot" then &
  "pair_style  transformers_ace/aot" &
  "pair_coeff  * * ${model} Cs Pb I" &
else &
  "pair_style  transformers_ace" &
  "pair_coeff  * * ${model} Cs Pb I"

neighbor        1.0 bin
neigh_modify    delay 5 every 1

velocity        all create 400.0 1428 dist gaussian
fix             1 all nve
timestep        0.002

thermo          50
thermo_style    custom step temp pe ke etotal press
run             30
reset_timestep  0
run             100

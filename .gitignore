# Python and local environments
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# macOS and editor metadata
.DS_Store
.idea/
.vscode/

# Large datasets and trained checkpoints
*.extxyz
*.pt
*.pth
checkpoints/

# AOTI deployment packages. These are compiled for one GPU architecture and one
# CUDA toolkit, so they are reproducible build output rather than source, and
# are useless on any other host. Note *.pt does not match *.pt2.
*.pt2
*.pt2.metadata.txt

# Published reproducibility bundle
!training/train.extxyz
!training/model.pt
!tests/run_lammps/model.transformers_ace.pt

# Generated training artifacts
plots/
training/plots/
!training/plots/
training/plots/*
!training/plots/training_curves.png
!training/plots/training_history.csv

# Generated document build artifacts
output/pdf/*.aux
output/pdf/*.log
output/pdf/*.out

# Generated CsPbI3 relaxation workspaces
tests/cspbi3/alpha/
tests/cspbi3/beta/
tests/cspbi3/cubic/
tests/cspbi3/delta/
tests/cspbi3/gamma/
tests/cspbi3/ortho/
tests/cspbi3/rE.png
tests/cspbi3/rE.pdf
tests/cspbi3/relative_energies.csv
tests/cspbi3/results/*
!tests/cspbi3/results/.gitignore
!tests/cspbi3/results/phase_energies.csv
!tests/cspbi3/results/relative_energies.csv
!tests/cspbi3/results/rE.png
!tests/cspbi3/results/rE.pdf

# Machine-specific benchmark configuration
flashace_cspbi3_50.yaml
training/subsample_extxyz.py

# Generated reactive-sampling artifacts
training_examples/active_learning_metadynamics/.download_cache/
training_examples/active_learning_metadynamics/*/evaluation/
training_examples/active_learning_metadynamics/*/models/
training_examples/active_learning_metadynamics/*/results/

# Bulk simulation output. The published repository is ~13 MB of source, docs and
# small reference data; these directories hold multi-GB run output that is
# regenerated by the scripts and must never enter git history.
training_examples/**/*.extxyz
training_examples/**/*.xyz
training_examples/**/*.pt
training_examples/**/dump.*
training_examples/**/*.lammpstrj
training_examples/**/*.dcd
tmp/
output/overleaf/
output/pdf/manuscript_versions/
tests/cspbi3/free_energy_ti/
tests/cspbi3/free_energy_ti_480/
tests/run_lammps/water_ccsd/
tests/run_lammps/benchmark_aot/runs/
tests/run_lammps/benchmark_aot/log.*
experiments/**/runs/
experiments/**/logs/
experiments/**/smoke/
output/pdf/*.bbl
output/pdf/*.blg
output/pdf/*.fdb_latexmk
output/pdf/*.fls
output/pdf/*Notes.bib
